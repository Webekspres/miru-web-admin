# MIRU Web Admin — Environment Variables
# Salin ke .env.local untuk development lokal

# Base URL backend (TANPA trailing slash, TANPA /api di akhir)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Nama aplikasi (header, title)
NEXT_PUBLIC_APP_NAME=MIRU Bank Sampah

# Opsional: enable debug log API di console (development only)
# NEXT_PUBLIC_API_DEBUG=true
